# Default: normalize to LF in the repo, let git handle the working tree.
* text=auto eol=lf

# Windows-native scripts: keep CRLF in the working tree.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Bash shim MUST stay LF or it breaks under bash.
bin/azl text eol=lf

# Docs
*.md text eol=lf
